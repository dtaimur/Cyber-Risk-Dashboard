# Copy to .env and fill in. Never commit .env.
# Sign-in passwords (if unset, random ones are generated into /data/.demo-credentials)
DASHBOARD_PASSWORD_EXECUTIVE=
DASHBOARD_PASSWORD_ANALYST=
DASHBOARD_PASSWORD_ADMIN=
# Fernet key for encrypting integration credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DASHBOARD_SECRET_KEY=
# Claude API key for the AI Analyst (optional; the assistant shows as not configured without it)
ANTHROPIC_API_KEY=
